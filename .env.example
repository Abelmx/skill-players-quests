# =============================================================================
# Skill-Players-Quests 环境变量配置
# 复制为 .env 并填入实际值，框架自动从环境变量读取。
# 未设置的可选项将使用 API 默认值（不传给接口）。
# =============================================================================


# -----------------------------------------------------------------------------
# 1. Provider API Key
#    Provider 在 configs/default.yaml 中定义，每个 provider 有一个 api_key_env
#    字段指定从哪个环境变量读取 API key。
#    models 列表也在 YAML 中配置，无需在 .env 中重复。
# -----------------------------------------------------------------------------

# 默认 provider (nanobanana) 的 API key
SPQ_API_KEY=""

# 如果添加了 local-vllm provider，配置其 key
# SPQ_VLLM_API_KEY=""


# -----------------------------------------------------------------------------
# 2. 模型推理超参数（可选）
#    未设置时不传给 API，由 API 自身使用默认值。
#    全局参数所有 provider 共享；per-provider 参数优先级更高。
# -----------------------------------------------------------------------------

# --- 全局默认 ---
# SPQ_TEMPERATURE=                            # 采样温度，如 0.0 / 0.7 / 1.0
# SPQ_TOP_P=                                  # nucleus sampling 概率，如 0.9 / 1.0
# SPQ_MAX_TOKENS=                             # 最大输出 token 数，如 4096 / 8192

# --- 按 provider 覆盖（优先级高于全局） ---
# SPQ_NANOBANANA_TEMPERATURE=
# SPQ_NANOBANANA_TOP_P=
# SPQ_NANOBANANA_MAX_TOKENS=


# -----------------------------------------------------------------------------
# 3. Skills 依赖的外部凭证
#    只有对应 skill 被某个 task 的 expected_skills 引用时才需要配置。
# -----------------------------------------------------------------------------

# [image-gen] 图像生成 — OpenAI 兼容接口 (nanobanana / Gemini proxy 等)
# 用于: Task 1 (generate-cyberpunk-image)
IMAGE_GEN_API_KEY=""
IMAGE_GEN_BASE_URL=""
IMAGE_GEN_MODEL="gemini-2.0-flash-exp-image-generation"
# IMAGE_GEN_TIMEOUT=120

# [github] GitHub CLI 认证
# 用于: Task 5 (react-bug-issues)
GITHUB_TOKEN=""

# [email-sender] SMTP 邮件发送（干扰 skill，评测中不需要）
# SMTP_HOST=""
# SMTP_USER=""
# SMTP_PASS=""


# -----------------------------------------------------------------------------
# 4. 框架运行参数
# -----------------------------------------------------------------------------

# SPQ_ACTIVATION_MODE="catalog"               # 激活模式: catalog / full_inject
# SPQ_MAX_TURNS=10                            # 单任务最大对话轮数
# SPQ_BASH_TIMEOUT=30                         # bash 命令超时秒数
